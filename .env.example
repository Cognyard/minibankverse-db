# Copy to .env and adjust as needed: cp .env.example .env
# docker compose reads .env automatically from this folder.

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- pgAdmin ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# --- Host ports ---
# Change when 5432 is already used on the host (e.g. a local PostgreSQL service).
POSTGRES_PORT=5432
